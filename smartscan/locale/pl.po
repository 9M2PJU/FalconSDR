msgstr "Błąd odświeżania"

msgid "disabled"
msgstr "wyłączona"

msgid "done"
msgstr "gotowe"

msgid "★ In favorites"
msgstr "★ W ulubionych"

msgid "Transcript:"
msgstr "Transkrypcja:"

msgid "waiting in the queue…"
msgstr "oczekuje w kolejce…"

msgid "disabled (click “Re-transcribe” to try manually)"
msgstr "wyłączona (kliknij “Transkrybuj ponownie”, by spróbować ręcznie)"

msgid "Transcript: recording too short, skipped"
msgstr "Transkrypcja: nagranie zbyt krótkie, pominięte"

msgid "Transcript: no speech detected (just noise/squelch crackle)"
msgstr "Transkrypcja: nie wykryto mowy (sam szum/trzask squelchu)"

msgid "Transcript: error (try again)"
