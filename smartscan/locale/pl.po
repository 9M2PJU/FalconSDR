msgstr "Standardowe pasmo lotnictwa cywilnego: wieże, zbliżanie, kontrola obszaru."

msgid "Military VHF (137-144 MHz)"
msgstr "Wojskowe VHF (137-144 MHz)"

msgid "Military VHF band adjacent to civil aviation."
msgstr "Wojskowe pasmo VHF sąsiadujące z lotnictwem cywilnym."

msgid "Military UHF NATO (225-400 MHz)"
msgstr "Wojskowe UHF NATO (225-400 MHz)"

msgid "Harmonized NATO UHF band: air-to-air refueling,\nQRA/Baltic Air Policing, exercises."
msgstr "Zharmonizowane pasmo NATO UHF: tankowanie w powietrzu,\nQRA/Baltic Air Policing, ćwiczenia."

msgid "PMR446 (446.00625-446.19375 MHz)"
msgstr "PMR446 (446.00625-446.19375 MHz)"

msgid "License-free PMR446 walkie-talkies (16 analog channels, NFM).\nVery good chance of catching something nearby - popular on\ntrips, construction sites, at hotels/campsites."
msgstr "Bezlicencyjne krótkofalówki PMR446 (16 kanałów analogowych, NFM).\nBardzo duża szansa złapania czegoś w pobliżu - popularne na\nwycieczkach, budowach, w hotelach/kampingach."

msgid "Ham 2m (144-146 MHz)"
msgstr "Amatorskie 2m (144-146 MHz)"

msgid "2m amateur radio band (VHF, NFM): repeaters and simplex."
msgstr "Pasmo radioamatorskie 2m (VHF, NFM): przemienniki i łączność bezpośrednia."

msgid "Ham 70cm (430-440 MHz)"
msgstr "Amatorskie 70cm (430-440 MHz)"

msgid "70cm amateur radio band (UHF, NFM): repeaters and simplex."
msgstr "Pasmo radioamatorskie 70cm (UHF, NFM): przemienniki i łączność bezpośrednia."

msgid "Marine VHF (156-162 MHz)"
msgstr "Morskie VHF (156-162 MHz)"

msgid "Marine VHF band (channels 1-88, including channel 16 - calling/\ndistress, NFM). Useful near a coast, harbor, or a lake with shipping traffic."
msgstr "Morskie pasmo VHF (kanały 1-88, w tym kanał 16 - wywoławczy/ratunkowy, NFM).\nPrzydatne w pobliżu wybrzeża, portu lub jeziora ze szlakiem żeglugowym."

msgid "FM broadcast radio (87.5-108 MHz)"
msgstr "Radio FM (87.5-108 MHz)"

