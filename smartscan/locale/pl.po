# --- gui/panels/location_panel.py ---

msgid "Location"
msgstr "Lokalizacja"

msgid "Approximate coordinates of the receiver - used only to build "
"the FlightRadar24/ADSBExchange playback links in Odtwarzacz "
"(“what was flying near here at this recording's time”). "
"Nothing is sent anywhere else; this never leaves your machine "
"except when you click one of those two buttons, which opens "
"your browser at that flight-tracker site. A nearby town/city is "
"plenty precise - you don't need your exact address."
msgstr "Przybliżone współrzędne odbiornika - używane wyłącznie do zbudowania "
"linków playbacku FlightRadar24/ADSBExchange w Odtwarzaczu "
"(“co leciało tędy w czasie tego nagrania”). "
"Nic nigdzie indziej nie jest wysyłane; to nigdy nie opuszcza Twojego komputera "
"poza chwilą kliknięcia jednego z tych dwóch przycisków, co otwiera "
"przeglądarkę na stronie danego serwisu. Pobliskie miasto/miejscowość jest "
"wystarczająco dokładne - nie musisz podawać dokładnego adresu."

msgid "(not set)"
msgstr "(nie ustawiono)"

msgid "Latitude:"
msgstr "Szerokość geograficzna:"

msgid "Longitude:"
msgstr "Długość geograficzna:"

